{
    "layer": "top",
    "position": "top",
    "spacing": 0,
    "margin-top": 0,
    "margin-left": 0,
    "margin-right": 0,
    "margin-bottom": 0,
    "height": 36,
    "modules-left": ["custom/launcher", "hyprland/workspaces"],
    "modules-center": ["hyprland/workspaces#taskbar"],
    "modules-right": ["tray", "pulseaudio", "memory","cpu", "battery", "clock"],
    "custom/launcher": {
        "format": "",
        "tooltip": false,
        "on-click": "wofi --show drun"
    },
    "hyprland/workspaces": {
        "format": "{name}",
        "sort-by-number": true,
        "persistent-workspaces": {
            "*": 10
        },
        "on-click": "activate",
        "on-scroll-up": "hyprctl dispatch workspace e+1",
        "on-scroll-down": "hyprctl dispatch workspace e-1"
    },
    "hyprland/workspaces#taskbar": {
        "active-only": true,
        "format": "{windows}",
        "format-window-separator": "",
        "all-outputs": false,
        "workspace-taskbar": {
            "enable": true,
            "update-active-window": true,
            "format": "{icon}",
            "icon-size": 24,
            "orientation": "horizontal",
            "on-click-window": "hyprctl dispatch focuswindow address:{address}"
        }
    },
    "tray": {
        "icon-size":18,
        "spacing": 10
    },
    "clock": {
        "interval": 1,
        "format": "{:%Y/%m/%d %H:%M:%S}",
        "tooltip-format": "<tt><small>{calendar}</small></tt>",
		"timezone": "Asia/Chongqing",
        "calendar": {
            "mode"          : "month",
            "mode-mon-col"  : 3,
            "weeks-pos"     : "right",
            "on-scroll"     : 1,
            "format": {
                "months":     "<span color='#ffead3'><b>{}</b></span>",
                "days":       "<span color='#ecc6d9'><b>{}</b></span>",
                "weeks":      "<span color='#99ffdd'><b>W{}</b></span>",
                "weekdays":   "<span color='#ffcc66'><b>{}</b></span>",
                "today":      "<span color='#ff6699'><b><u>{}</u></b></span>"
            }
        },
        "actions": {
            "on-click-right": "mode",
            "on-click-forward": "tz_up",
            "on-click-backward": "tz_down",
            "on-scroll-up": "shift_up",
            "on-scroll-down": "shift_down"
        }
    },
    "cpu": {
        "interval": 1,
        "format": "<span font_family='Font Awesome 7 Free' weight='900'>\uf2db</span> {usage:2}%",
        "tooltip": true
    },
    "memory": {
        "interval": 1,
        "format": "\uf538 {used:0.1f}G",
        "tooltip": true,
        "tooltip-format": " RAM: {used:0.2f}G / {total:0.2f}G\nSwap: {swapUsed:0.2f}G / {swapTotal:0.2f}G"
    },
    "network": {
        "interval": 1,
        "format-wifi": "\uf1eb {essid}",
        "format-ethernet": "\uf6ff {ifname}",
        "format-linked": "\uf059 No IP ({ifname})",
        "format-disconnected": "\uf071 Disconnected",
        "tooltip-format": "{ifname} {ipaddr}/{cidr} via {gwaddr}",
        "format-alt": "\uf6ff {ipaddr}/{cidr}"
    },
    "battery": {
        "bat": "BAT0",
        "interval": 60,
        "states": {
            "warning": 30,
            "critical": 15
        },
        "format": "{icon} {capacity}%",
        "format-icons": [
            "<span font_family='Font Awesome 7 Free' weight='900'>\uf244</span>",
            "<span font_family='Font Awesome 7 Free' weight='900'>\uf243</span>",
            "<span font_family='Font Awesome 7 Free' weight='900'>\uf242</span>",
            "<span font_family='Font Awesome 7 Free' weight='900'>\uf241</span>",
            "<span font_family='Font Awesome 7 Free' weight='900'>\uf240</span>"
        ],
        "max-length": 7,
        "min-length": 7
    },
    "pulseaudio": {
        "scroll-step": 5,
        "format": "{icon} {volume:2}%",
        "format-muted": "<span font_family='Font Awesome 7 Free' weight='900'>\uf6a9</span>",
        "format-bluetooth": "{icon}<span font_family='Font Awesome 7 Free' weight='900'>\uf294</span> {volume}%",
        "format-bluetooth-muted": "<span font_family='Font Awesome 7 Free' weight='900'>\ufa69</span> {icon}<span font_family='Font Awesome 7 Free' weight='900'>\uf294</span>",
        "format-icons": {
            "default": [
                "<span font_family='Font Awesome 7 Free' weight='900'>\uf026</span>",
                "<span font_family='Font Awesome 7 Free' weight='900'>\uf027</span>",
                "<span font_family='Font Awesome 7 Free' weight='900'>\uf028</span>"
            ]
        },
        "on-click-right": "pavucontrol",
        "ignored-sinks": ["AudioRelay Virtual Sink", "Recorder Sink"]
    }
}
